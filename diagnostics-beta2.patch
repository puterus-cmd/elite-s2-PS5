@@ -263,6 +263,38 @@ static void api_log(web_t *w, int fd)
 }
 
 
+/* Downloads the complete report for the current PadBridge run. */
+static void api_session_log(int fd, const char *path, const char *filename)
+{
+    FILE *f;
+    char *buf;
+    long size;
+    char head[320];
+    int hn;
+
+    if (!path || !(f = fopen(path, "rb"))) {
+        respond_text(fd, 404, "{\"error\":\"session report unavailable\"}");
+        return;
+    }
+    if (fseek(f, 0, SEEK_END) != 0 || (size = ftell(f)) < 0 || size > (1L << 20) || fseek(f, 0, SEEK_SET) != 0) {
+        fclose(f);
+        respond_text(fd, 500, "{\"error\":\"could not read session report\"}");
+        return;
+    }
+    buf = malloc((size_t)size + 1);
+    if (!buf) { fclose(f); respond_text(fd, 500, "{\"error\":\"out of memory\"}"); return; }
+    size = (long)fread(buf, 1, (size_t)size, f);
+    fclose(f);
+    hn = snprintf(head, sizeof head,
+                  "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\n"
+                  "Content-Length: %ld\r\nContent-Disposition: attachment; filename=\"%s\"\r\n"
+                  "Cache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nConnection: close\r\n\r\n", size, filename);
+    send_all(fd, head, (size_t)hn);
+    send_all(fd, buf, (size_t)size);
+    free(buf);
+}
+
+
 /* Reads and URL-decodes a bounded query parameter. */
 static int query_value(const char *path, const char *name, char *out, size_t max)
 {
